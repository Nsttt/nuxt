{
  "name": "@nuxt/rsbuild-builder",
  "version": "4.3.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt/nuxt.git",
    "directory": "packages/rsbuild"
  },
  "description": "Rsbuild bundler for Nuxt",
  "homepage": "https://nuxt.com",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "tsdown",
    "build": "tsdown",
    "test:attw": "node ../../scripts/test-attw.ts"
  },
  "dependencies": {
    "@nuxt/kit": "workspace:*",
    "@rsbuild/core": "^2.2.11",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@vue/compiler-sfc": "3.5.38",
    "defu": "^6.1.7",
    "escape-string-regexp": "^5.0.0",
    "exsolve": "^1.1.0",
    "get-port-please": "^3.2.0",
    "jiti": "^2.7.0",
    "knitwork": "^1.3.0",
    "mlly": "^1.8.2",
    "ohash": "^2.0.11",
    "pathe": "^2.0.3",
    "rolldown-string": "^0.3.0",
    "seroval": "^1.5.4",
    "ufo": "^1.6.4",
    "unenv": "^2.0.0-rc.24",
    "vue-bundle-renderer": "^2.3.1"
  },
  "devDependencies": {
    "@nuxt/schema": "workspace:*",
    "@rsbuild/plugin-type-check": "1.6.0",
    "@types/webpack-bundle-analyzer": "4.7.0",
    "h3": "1.15.11",
    "h3-next": "npm:h3@2.0.1-rc.22",
    "rollup": "4.62.2",
    "tsdown": "0.22.3",
    "vue": "3.5.38",
    "webpack-bundle-analyzer": "5.3.0"
  },
  "peerDependencies": {
    "@rsbuild/plugin-type-check": "^1.6.0",
    "nuxt": "workspace:*",
    "vue": "^3.3.4",
    "webpack-bundle-analyzer": "^5.3.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/plugin-type-check": {
      "optional": true
    },
    "webpack-bundle-analyzer": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.11.0 || >=26.0.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
